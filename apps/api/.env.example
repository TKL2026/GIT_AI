NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copilote_ia_business?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Optionnel : sans cette clé, l'API démarre normalement mais les routes /copilot
# renvoient 503. Obtenez une clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optionnel : routage Haiku/Sonnet du Copilot (voir model-router.ts). Sans
# valeur, les défauts du moteur sont utilisés.
ANTHROPIC_HAIKU_MODEL=
ANTHROPIC_SONNET_MODEL=

# Optionnel : sans cette clé, les emails (reset mot de passe, invitations
# d'équipe) sont seulement journalisés côté serveur au lieu d'être envoyés.
# Obtenez une clé sur https://resend.com
RESEND_API_KEY=
# Expéditeur affiché. Le défaut (onboarding@resend.dev) ne fonctionne que pour
# tester en envoyant à l'adresse de votre propre compte Resend — vérifiez
# votre propre domaine sur resend.com avant un vrai lancement.
MAIL_FROM=Copilote IA Business <onboarding@resend.dev>

# Optionnel : sans DSN, l'API démarre normalement, Sentry reste inactif.
# Obtenez un DSN sur https://sentry.io (créez un projet Node/NestJS).
SENTRY_DSN=

# Optionnel : pour les notifications/chat WhatsApp. Obtenez ces valeurs sur
# developers.facebook.com (App > WhatsApp > API Setup).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Numéro (avec indicatif, ex: +225XXXXXXXXX) ajouté comme destinataire de
# test côté Meta — c'est là que partiront les alertes/rapports.
WHATSAPP_NOTIFICATION_RECIPIENT=

# Optionnel : pour le chat entrant WhatsApp (webhook). Le token de
# vérification est une valeur arbitraire que vous choisissez et collez
# aussi dans Meta App Dashboard > WhatsApp > Configuration > Webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App Dashboard > Paramètres > Général > "Clé secrète de l'application"
WHATSAPP_APP_SECRET=
# Organisation vers laquelle router les messages WhatsApp entrants
WHATSAPP_INBOUND_ORGANIZATION_ID=

# Optionnel : pour les paiements Mobile Money (abonnement UGE). Sans ces
# valeurs, l'API démarre normalement mais /billing/checkout renvoie 503.
# Créez un compte sur https://www.campay.net (sandbox : https://demo.campay.net).
CAMPAY_ENV=sandbox
# Identifiant affiché dans le dashboard CamPay (App Keys) — pas transmis aux
# appels API, juste pour référence.
CAMPAY_ID=
# Méthode recommandée : un jeton qui n'expire jamais (Dashboard > App Keys >
# Permanent Access Token). Si renseigné, CAMPAY_USERNAME/CAMPAY_PASSWORD
# ci-dessous sont ignorés.
CAMPAY_PERMANENT_TOKEN=
# Repli si CAMPAY_PERMANENT_TOKEN n'est pas renseigné (authentification par
# échange username/password contre un jeton temporaire).
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# Clé utilisée pour vérifier la signature JWT du webhook CamPay (Dashboard >
# Paramètres de l'application > Clé de webhook).
CAMPAY_WEBHOOK_KEY=
# Optionnel : ne renseigner que pour surcharger l'URL de base déduite de
# CAMPAY_ENV (utile en debug/proxy uniquement).
CAMPAY_BASE_URL=

# Optionnel : désactivé par défaut (recommandé). N'activer que pour la durée
# d'un audit externe temporaire — active la route POST /auth/demo-login (et
# /demo côté frontend), qui connecte sans mot de passe au compte démo fixe
# ci-dessous. Ne jamais laisser à "true" en usage durable.
DEMO_MODE_ENABLED=false
# Email du compte utilisé par le mode démo (doit déjà exister). Par défaut : owner@demo.com
DEMO_USER_EMAIL=
