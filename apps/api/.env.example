NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copilote_ia_business?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Secret dédié à l'espace /admin (back-office plateforme) — DOIT être
# différent de JWT_ACCESS_SECRET/JWT_REFRESH_SECRET : un token d'organisation
# ne doit jamais pouvoir être valide côté admin, ni l'inverse.
JWT_PLATFORM_ADMIN_SECRET=change-me-platform-admin-secret-min-16-chars
JWT_PLATFORM_ADMIN_EXPIRES_IN=8h

# Clé HMAC servant à hasher le code de vérification à 6 chiffres envoyé à la
# connexion (voir AuthService#verifyLoginCode) — jamais le code en clair en
# base. DOIT être différente des secrets JWT ci-dessus.
LOGIN_CODE_PEPPER=change-me-login-code-pepper-min-16-chars

CORS_ORIGIN=http://localhost:5173

# Optionnel : sans cette clé, l'API démarre normalement mais les routes /copilot
# renvoient 503. Obtenez une clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optionnel : routage Haiku/Sonnet du Copilot (voir model-router.ts). Sans
# valeur, les défauts du moteur sont utilisés.
ANTHROPIC_HAIKU_MODEL=
ANTHROPIC_SONNET_MODEL=

# Optionnel : sans cette clé, les emails (reset mot de passe, invitations
# d'équipe) sont seulement journalisés côté serveur au lieu d'être envoyés.
# Obtenez une clé sur https://resend.com
RESEND_API_KEY=
# Expéditeur affiché. Le défaut (onboarding@resend.dev) ne fonctionne que pour
# tester en envoyant à l'adresse de votre propre compte Resend — vérifiez
# votre propre domaine sur resend.com avant un vrai lancement.
MAIL_FROM=UGE <onboarding@resend.dev>

# Optionnel : sans DSN, l'API démarre normalement, Sentry reste inactif.
# Obtenez un DSN sur https://sentry.io (créez un projet Node/NestJS).
SENTRY_DSN=

# Optionnel : pour l'envoi WhatsApp (rapport quotidien automatique à 22h
# Africa/Douala, et numéro de test). Obtenez ces valeurs sur
# developers.facebook.com (App > WhatsApp > API Setup).
# UGE n'est PAS un chatbot : aucun message entrant ne déclenche de réponse.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Numéro de test (avec indicatif, ex: +225XXXXXXXXX) utilisé uniquement par
# POST /whatsapp/send-test — les rapports eux-mêmes partent vers les numéros
# configurés par organisation (voir Organization.whatsappRecipients).
WHATSAPP_NOTIFICATION_RECIPIENT=

# Vérification technique du webhook (handshake Meta + signature des
# requêtes entrantes) — nécessaire même sans traitement métier côté UGE.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App Dashboard > Paramètres > Général > "Clé secrète de l'application"
WHATSAPP_APP_SECRET=

# Obligatoires ENSEMBLE pour que le rapport quotidien automatique (22h
# Africa/Douala) parte réellement : le destinataire n'écrit jamais au numéro
# WhatsApp Business (UGE n'est pas un chatbot), donc la fenêtre de service de
# 24h de Meta est toujours fermée à l'heure de l'envoi — seul un message
# template PRÉALABLEMENT SOUMIS ET APPROUVÉ dans Meta Business Suite /
# WhatsApp Manager peut être envoyé dans ce cas. Sans ces deux variables,
# l'envoi échoue proprement (journalisé en FAILED) au lieu de tenter un
# message en texte libre qui serait de toute façon rejeté par Meta.
# Nom exact du modèle approuvé, par ex: uge_daily_report
WHATSAPP_REPORT_TEMPLATE_NAME=
# Code de langue EXACTEMENT tel que choisi lors de la soumission du modèle
# (ex: fr) — un mauvais code fait rejeter l'envoi par l'API Graph.
WHATSAPP_REPORT_TEMPLATE_LANGUAGE=

# Mise en pause temporaire des envois WhatsApp (lancement UGE sans dépendre
# des délais de validation d'entreprise Meta). ABSENTE = en pause par défaut
# (comportement sûr). Positionner explicitement "false" pour réactiver les
# envois une fois la validation Meta terminée.
WHATSAPP_REPORTS_PAUSED=

# Optionnel : pour les paiements Mobile Money (abonnement UGE). Sans ces
# valeurs, l'API démarre normalement mais /billing/checkout renvoie 503.
# Créez un compte sur https://www.campay.net (sandbox : https://demo.campay.net).
CAMPAY_ENV=sandbox
# Identifiant affiché dans le dashboard CamPay (App Keys) — pas transmis aux
# appels API, juste pour référence.
CAMPAY_ID=
# Méthode recommandée : un jeton qui n'expire jamais (Dashboard > App Keys >
# Permanent Access Token). Si renseigné, CAMPAY_USERNAME/CAMPAY_PASSWORD
# ci-dessous sont ignorés.
CAMPAY_PERMANENT_TOKEN=
# Repli si CAMPAY_PERMANENT_TOKEN n'est pas renseigné (authentification par
# échange username/password contre un jeton temporaire).
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# Clé utilisée pour vérifier la signature JWT du webhook CamPay (Dashboard >
# Paramètres de l'application > Clé de webhook).
CAMPAY_WEBHOOK_KEY=
# Optionnel : ne renseigner que pour surcharger l'URL de base déduite de
# CAMPAY_ENV (utile en debug/proxy uniquement).
CAMPAY_BASE_URL=

# Optionnel : désactivé par défaut (recommandé). N'activer que pour la durée
# d'un audit externe temporaire — active la route POST /auth/demo-login (et
# /demo côté frontend), qui connecte sans mot de passe au compte démo fixe
# ci-dessous. Ne jamais laisser à "true" en usage durable.
DEMO_MODE_ENABLED=false
# Email du compte utilisé par le mode démo (doit déjà exister). Par défaut : owner@demo.com
DEMO_USER_EMAIL=

# Optionnel : si définie, ce compte (identifié par email) saute l'étape de
# code de vérification à la connexion — email + mot de passe suffisent.
# Réservé à un compte démo partagé publiquement, jamais un compte réel.
TWO_FA_BYPASS_EMAIL=

# Optionnel, défaut désactivé ("false"). Active le Programme de lancement
# Cameroun (90 jours gratuits, accès Pro complet, quota Copilote par
# utilisateur) pour toute nouvelle inscription sans offre payante choisie.
# Repasser à "false" (ou supprimer) pour revenir au TRIAL de 7 jours.
LAUNCH_PROGRAM_ENABLED=false
# Durée en jours du Programme de lancement (défaut "90" si absent).
LAUNCH_PROGRAM_TRIAL_DAYS=
# Quota Copilote mensuel par utilisateur pour LAUNCH_PROGRAM (défaut "700").
LAUNCH_PROGRAM_COPILOT_QUOTA=
