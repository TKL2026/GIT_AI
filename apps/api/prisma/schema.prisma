generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev local ; l'image Docker (Alpine récent, sans OpenSSL
  // 1.1) a besoin du moteur musl compilé pour OpenSSL 3.x, sinon Prisma
  // échoue silencieusement au runtime ("Could not parse schema engine response").
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  DIRECTOR
  STOCK_MANAGER
  CASHIER
  EMPLOYEE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  OTHER
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SUPPLIES
  TRANSPORT
  OTHER
}

enum SubscriptionStatus {
  /// Essai gratuit de 7 jours en cours — accès complet.
  TRIAL
  /// Offre payante choisie à l'inscription, paiement jamais confirmé — aucun
  /// accès, distinct de TRIAL (jamais eu d'essai) et de TRIAL_EXPIRED (essai
  /// consommé) : sémantique métier différente, voir subscription-status.util.ts.
  AWAITING_PAYMENT
  ACTIVE
  PAST_DUE
  /// Réservé pour un futur abonnement payant expiré (non renouvelé) —
  /// rien dans le code ne produit ce statut aujourd'hui, voir TRIAL_EXPIRED
  /// pour le cas "essai gratuit consommé".
  EXPIRED
  /// Essai gratuit de 7 jours consommé sans paiement — distinct de EXPIRED.
  TRIAL_EXPIRED
  CANCELLED
}

enum SubscriptionPeriod {
  MONTHLY
  YEARLY
}

enum PaymentProvider {
  CAMPAY
}

/// Opérateur mobile money choisi par l'utilisateur à l'écran de paiement —
/// informatif seulement : CamPay déduit lui-même l'opérateur réel depuis le
/// préfixe du numéro, ce champ ne lui est jamais transmis.
enum MobileMoneyOperator {
  MTN
  ORANGE
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  // Onboarding — tous nullable/valeur par défaut vide : une organisation
  // existante avant cette fonctionnalité reste valide sans backfill de ces
  // champs eux-mêmes (seuls onboardingStep/onboardingCompletedAt sont
  // backfillés, voir migration, pour ne pas renvoyer les comptes existants
  // dans l'assistant d'inscription).
  country               String?
  // Déploiement Cameroun uniquement pour l'instant — une seule devise réelle
  // (XAF), fixée par défaut plutôt que proposée comme un choix qui n'a
  // aucun effet ailleurs dans l'app (l'affichage est toujours en FCFA).
  currency              String?   @default("XAF")
  industry              String?
  teamSize              String?
  modules               String[]  @default([])
  onboardingStep        String?
  onboardingCompletedAt DateTime?

  /// Suspension décidée par un administrateur plateforme (support/abus) —
  /// distincte du cycle de facturation (SubscriptionStatus) : un admin peut
  /// suspendre même un abonnement payant ACTIVE. Vérifiée par SubscriptionGuard
  /// en plus (jamais à la place) de isSubscriptionLocked().
  suspendedAt DateTime?

  users               User[]
  products            Product[]
  stockMovements      StockMovement[]
  sales               Sale[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  expenses            Expense[]
  pendingInvites      PendingInvite[]
  subscription        Subscription?
  paymentTransactions PaymentTransaction[]
  copilotUsageLogs    CopilotUsageLog[]

  @@map("organizations")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            Role      @default(EMPLOYEE)
  organizationId  String
  // Vérification "douce" : ne bloque pas l'accès au produit (l'onboarding ne
  // doit pas être interrompu), sert juste à confirmer que l'email est
  // valide/atteignable — notamment pour que "mot de passe oublié" fonctionne.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  stockMovements        StockMovement[]
  sales                 Sale[]
  purchaseOrders        PurchaseOrder[]
  expenses              Expense[]

  @@index([organizationId])
  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PendingInvite {
  id              String    @id @default(uuid())
  organizationId  String
  email           String
  role            Role
  token           String    @unique
  invitedByUserId String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  acceptedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("pending_invites")
}

model Product {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  sku            String
  purchasePrice  Decimal  @db.Decimal(12, 2)
  salePrice      Decimal  @db.Decimal(12, 2)
  stockQuantity  Int      @default(0)
  minStock       Int?
  maxStock       Int?
  /// Archivage (BUG-004) : un produit déjà vendu ne peut pas être supprimé
  /// physiquement (SaleItem.product est onDelete: Restrict). isActive=false
  /// le masque des listes/sélecteurs de vente et d'achat sans perdre son
  /// historique.
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovements      StockMovement[]
  saleItems           SaleItem[]
  purchaseOrderItems  PurchaseOrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("products")
}

model StockMovement {
  id                 String            @id @default(uuid())
  organizationId     String
  productId          String
  performedByUserId  String
  type               StockMovementType
  quantity           Int
  previousQuantity   Int
  newQuantity        Int
  reason             String?
  createdAt          DateTime          @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  performedByUser User       @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([productId])
  @@map("stock_movements")
}

model Sale {
  id                String        @id @default(uuid())
  organizationId    String
  performedByUserId String
  customerName      String?
  customerPhone     String?
  paymentMethod     PaymentMethod
  totalAmount       Decimal       @db.Decimal(12, 2)
  createdAt         DateTime      @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  performedByUser User         @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  items           SaleItem[]

  @@index([organizationId])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  /// Coût d'achat figé au moment de la vente (BUG-006) : ne doit jamais
  /// être relu/recalculé après coup, pour que le COGS d'une vente déjà
  /// conclue reste stable même si une réception ultérieure change
  /// Product.purchasePrice.
  unitCost    Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Supplier {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
  @@map("suppliers")
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  organizationId    String
  supplierId        String
  performedByUserId String
  status            PurchaseOrderStatus @default(PENDING)
  totalAmount       Decimal             @db.Decimal(12, 2)
  createdAt         DateTime            @default(now())
  receivedAt        DateTime?

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  performedByUser  User                @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  items            PurchaseOrderItem[]

  @@index([organizationId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  productId       String
  productName     String
  quantity        Int
  unitCost        Decimal @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model Expense {
  id                String          @id @default(uuid())
  organizationId    String
  performedByUserId String
  category          ExpenseCategory
  description       String?
  amount            Decimal         @db.Decimal(12, 2)
  expenseDate       DateTime        @default(now())
  createdAt         DateTime        @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  performedByUser User         @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("expenses")
}

/// Plan d'abonnement UGE. `code` est la clé stable utilisée par le code
/// (jamais l'id, pour permettre de recréer/réordonner sans casser de
/// référence en dur côté frontend). Prix placeholder — à ajuster plus tard.
model Plan {
  id        String              @id @default(uuid())
  code      String              @unique
  name      String
  price     Int
  currency  String              @default("XAF")
  period    SubscriptionPeriod  @default(MONTHLY)
  /// Limites/fonctionnalités libres (ex: {"maxUsers": 5, "modules": [...]})
  /// — évite une migration à chaque ajustement de grille tarifaire.
  features  Json?
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  subscriptions Subscription[]
  transactions  PaymentTransaction[]

  @@map("plans")
}

/// Un seul abonnement par organisation (contrainte @unique). Absence de ligne
/// = organisation en accès libre (pas de restriction imposée par ce module
/// pour l'instant — voir note d'architecture).
model Subscription {
  id               String             @id @default(uuid())
  organizationId   String             @unique
  planId           String?
  status           SubscriptionStatus @default(TRIAL)
  startedAt        DateTime?
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  /// Nombre de requêtes Copilot consommées sur la période en cours — remis à
  /// zéro à chaque activation/renouvellement (voir billing.service.ts
  /// #activateSubscription). Jamais remis à zéro pendant un essai (une seule
  /// période de 7 jours, pas de renouvellement).
  copilotRequestsUsed Int              @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan?                @relation(fields: [planId], references: [id])
  transactions PaymentTransaction[]

  @@map("subscriptions")
}

/// Une tentative de paiement CamPay. `amount`/`currency` sont un instantané
/// du VRAI prix du plan au moment de la création — jamais une valeur reçue
/// du frontend. `externalReference` (la nôtre) et `providerReference`
/// (celle de CamPay) sont toutes deux uniques pour empêcher tout doublon,
/// et servent de verrou d'idempotence pour le webhook.
model PaymentTransaction {
  id                String                    @id @default(uuid())
  organizationId    String
  planId            String
  subscriptionId    String?
  amount            Int
  currency          String
  provider          PaymentProvider           @default(CAMPAY)
  operator          MobileMoneyOperator
  phoneNumber       String
  status            PaymentTransactionStatus  @default(PENDING)
  externalReference String                    @unique
  providerReference String?                   @unique
  providerStatusRaw String?
  metadata          Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  paidAt            DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@map("payment_transactions")
}

/// Administrateur de la PLATEFORME UGE — distinct des utilisateurs/rôles
/// organisationnels (User/Role). Volontairement une table séparée (pas un
/// Role de plus sur User) : un PLATFORM_ADMIN ne dépend d'aucune
/// organisation cliente et ne peut structurellement jamais être confondu
/// avec un OWNER (deux entités différentes, deux secrets JWT différents).
model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  auditLogs AdminAuditLog[]

  @@map("platform_admins")
}

/// Trace append-only des actions administratives (connexion, suspension...).
/// Jamais de secrets/mots de passe/tokens dans `metadata`. `onDelete:
/// Restrict` sur l'admin : on ne supprime jamais un compte admin qui a déjà
/// produit de l'historique, pour ne jamais perdre la traçabilité.
model AdminAuditLog {
  id              String   @id @default(uuid())
  platformAdminId String
  action          String
  targetType      String?
  targetId        String?
  metadata        Json?
  createdAt       DateTime @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)

  @@index([platformAdminId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

/// Métadonnées d'usage Copilot à des fins d'observabilité interne
/// (coût moyen par client/plan, répartition Haiku/Sonnet...) — jamais
/// exposé aux utilisateurs. Ne stocke volontairement aucun contenu de
/// conversation, uniquement des métriques.
model CopilotUsageLog {
  id             String   @id @default(uuid())
  organizationId String
  model          String
  inputTokens    Int?
  outputTokens   Int?
  durationMs     Int
  toolsUsed      String[] @default([])
  planCode       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
  @@map("copilot_usage_logs")
}
