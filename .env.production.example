# Config de production pour docker-compose.prod.yml.
# Copiez ce fichier en ".env" à la racine (même dossier que docker-compose.prod.yml)
# et remplissez chaque valeur. Ne committez jamais le ".env" réel.

# --- Base de données ---
POSTGRES_USER=postgres
# Mot de passe fort obligatoire — jamais "postgres" en production.
POSTGRES_PASSWORD=
POSTGRES_DB=copilote_ia_business
# Doit correspondre exactement à USER/PASSWORD/DB ci-dessus.
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@postgres:5432/copilote_ia_business?schema=public

# --- Authentification ---
# Déjà générés et prêts dans apps/api/.env.production.secrets (ne pas régénérer,
# ne jamais coller ces valeurs dans un chat ou un ticket).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Réseau ---
# Domaine public réel du site (celui que les utilisateurs visitent).
CORS_ORIGIN=https://votredomaine.com
# Aucune variable de port ici : sous Coolify, le service "web" n'expose pas
# de port hôte (voir docker-compose.prod.yml) — le domaine public se
# configure directement dans l'interface Coolify (champ "Domains" du
# service web), qui route vers le port 80 du conteneur nginx.

# --- Copilote IA (optionnel) ---
# Sans cette clé, /api/copilot renvoie 503 mais le reste de l'API fonctionne.
ANTHROPIC_API_KEY=

# --- Emails transactionnels (optionnel) ---
# Sans cette clé, les emails (reset mot de passe, invitations) sont
# seulement journalisés côté serveur au lieu d'être envoyés. Clé sur resend.com.
RESEND_API_KEY=
# Vérifiez votre propre domaine sur resend.com avant le vrai lancement —
# onboarding@resend.dev ne peut envoyer qu'à l'adresse de votre compte Resend.
MAIL_FROM=Copilote IA Business <contact@votredomaine.com>

# --- Monitoring d'erreurs (optionnel) ---
# Sans DSN, Sentry reste inactif (aucune erreur remontée). Créez un projet
# Node/NestJS sur https://sentry.io pour obtenir ce DSN.
SENTRY_DSN=

# --- WhatsApp (optionnel — cf. Niveau 2 de la mise en production Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_NOTIFICATION_RECIPIENT=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_INBOUND_ORGANIZATION_ID=

# --- Paiements CamPay / Mobile Money (optionnel — abonnement UGE) ---
# Sans ces valeurs, /api/billing/checkout renvoie 503 mais le reste de
# l'API fonctionne. Compte marchand sur https://www.campay.net.
CAMPAY_ENV=production
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_KEY=
CAMPAY_BASE_URL=

# --- Mode démo ---
# Ne jamais activer en usage durable — réservé à un audit externe temporaire.
DEMO_MODE_ENABLED=false
DEMO_USER_EMAIL=
